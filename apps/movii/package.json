{
  "name": "@movii/web",
  "version": "1.0.0",
  "private": true,
  "description": "watcha clone coding project",
  "type": "module",
  "prettier": "@movii/prettier-config",
  "scripts": {
    "analyze": "cross-env RSDOCTOR=true pnpm run build",
    "dev": "rsbuild serve --config rsbuild.dev.ts",
    "build": "rsbuild --config rsbuild.prod.ts build",
    "build:preview": "pnpm run build && npx serve dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@movii/icons": "workspace:*",
    "@movii/image": "workspace:*",
    "@tanstack/react-query": "^5.90.3",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "movii-carousel": "workspace:*",
    "radash": "^12.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.65.0",
    "react-intersection-observer": "^9.16.0",
    "react-router-dom": "^7.9.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@movii/eslint-config": "workspace:*",
    "@movii/prettier-config": "workspace:*",
    "@movii/typescript-config": "workspace:*",
    "@rsbuild/core": "^1.6.13",
    "@rsbuild/plugin-react": "^1.4.2",
    "@rsbuild/plugin-type-check": "^1.3.2",
    "@rsdoctor/rspack-plugin": "^1.3.9",
    "@tailwindcss/postcss": "^4.1.13",
    "@tanstack/eslint-plugin-query": "^5.91.1",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/dotenv-webpack": "^7.0.8",
    "@types/node": "^24.10.1",
    "@types/postcss-preset-env": "^7.7.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-router-dom": "^5.3.3",
    "cross-env": "^10.0.0",
    "eslint": "catalog:",
    "jiti": "^2.6.0",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^10.4.0",
    "prettier": "catalog:",
    "tailwindcss": "^4.1.13",
    "typescript": "catalog:"
  }
}
